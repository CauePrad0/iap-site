# ------------------------------------------------------------------
# Copie este arquivo para ".env" e ajuste. Sem .env, o site roda em modo mock.
# Atenção: todas as variáveis VITE_* ficam PÚBLICAS no site final.
# Nunca coloque aqui a "service_role key" do Supabase.
# ------------------------------------------------------------------

# true  = depoimentos de exemplo, salvos só no navegador (sem backend)
# false = usa o Supabase configurado abaixo
VITE_USE_MOCK=true

# Supabase na nuvem: Project Settings → API (Project URL e anon/publishable key)
# Supabase local (supabase start): http://127.0.0.1:54321 e a "anon key" exibida no terminal
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço público do site (usado no Open Graph / compartilhamento)
VITE_SITE_URL=https://exemplo.org
