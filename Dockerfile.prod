# Imagem de PRODUÇÃO local: gera o build estático e serve com nginx.
# Usada pelo serviço "prod" (profile "prod") do docker-compose.yml.

# ---- 1) build ----
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .

# Variáveis públicas embutidas no build (vêm do .env via docker-compose)
ARG VITE_USE_MOCK=true
ARG VITE_SUPABASE_URL=
ARG VITE_SUPABASE_ANON_KEY=
ARG VITE_SITE_URL=https://exemplo.org
ENV VITE_USE_MOCK=$VITE_USE_MOCK \
    VITE_SUPABASE_URL=$VITE_SUPABASE_URL \
    VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY \
    VITE_SITE_URL=$VITE_SITE_URL
RUN npm run build

# ---- 2) servidor ----
FROM nginx:1.27-alpine
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
